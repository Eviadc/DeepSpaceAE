<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.14.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DeepSpaceAE.Core/DeepSpaceAE.Core.csproj" />
    <!-- Real, local Steam Build 26496118 references. Never copy to output. -->
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameManagedDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireVerifiedGameBindings" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameManagedDir)' == ''" Code="EAE001"
           Text="GameAdapter requires real assemblies from the matching, legally available game version. GameManagedDir is unset. No game files are downloaded by this project. See docs/api-verification.md." />
    <ItemGroup>
      <RequiredGameAssembly Include="$(GameManagedDir)/Assembly-CSharp.dll;$(GameManagedDir)/UnityEngine.dll;$(GameManagedDir)/UnityEngine.CoreModule.dll;$(GameManagedDir)/0Harmony.dll;$(GameManagedDir)/UnityEngine.InputLegacyModule.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredGameAssembly.Identity)')" Code="EAE002"
           Text="Missing real game reference: %(RequiredGameAssembly.Identity). No stubs are provided." />
    <GetFileHash Files="$(GameManagedDir)/Assembly-CSharp.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="CheckedGameAssembly" />
    </GetFileHash>
    <Error Condition="'%(CheckedGameAssembly.FileHash)' != 'D9ABC029F6B390619C31175DF5735901AEC6DC071C35C50CE5B3FDF92E3EDE46'"
           Code="EAE004" Text="Unexpected Assembly-CSharp.dll hash. This adapter was checked against the local Steam Build 26496118 assembly only. Re-verify APIs before targeting another build." />
  </Target>
</Project>
